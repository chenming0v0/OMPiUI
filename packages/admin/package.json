{
  "name": "@ompiui/admin",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "description": "OMPiUI headless server manager with TUI and independent web console",
  "bin": {
    "ompiui-admin": "dist/cli.js"
  },
  "scripts": {
    "admin": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
