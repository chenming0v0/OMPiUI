{
  "name": "@ompiui/server",
  "version": "0.6.37",
  "private": true,
  "type": "module",
  "bin": {
    "omp-worker": "dist/bundle-entry.js"
  },
  "scripts": {
    "predev": "npm run build -w @ompiui/protocol && npm run build -w @ompiui/omp-worker",
    "dev": "node --import tsx src/index.ts",
    "predev:watch": "npm run predev",
    "dev:watch": "node --import tsx --watch --watch-preserve-output src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bundle-entry.js web",
    "omp-worker": "node --import tsx src/bundle-entry.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 src/**/*.test.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@ompiui/omp-worker": "0.6.37",
    "@ompiui/protocol": "0.6.37",
    "@ompiui/relay": "0.6.37",
    "bun-pty": "^0.4.8",
    "chokidar": "^4.0.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
