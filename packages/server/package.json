{
  "name": "@ompiui/server",
  "version": "0.6.21",
  "private": true,
  "type": "module",
  "bin": {
    "pi-worker": "dist/bundle-entry.js"
  },
  "scripts": {
    "predev": "npm run build -w @ompiui/protocol && npm run build -w @ompiui/pi-worker",
    "dev": "node --import tsx --watch --watch-preserve-output src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bundle-entry.js web",
    "pi-worker": "node --import tsx src/bundle-entry.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@ompiui/pi-worker": "0.7.0",
    "@ompiui/protocol": "0.6.21",
    "bun-pty": "^0.4.8",
    "chokidar": "^4.0.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
